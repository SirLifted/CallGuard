{
  "version": "1.0.0",
  "colors": {
    "primary": { "light": "#1A73E8", "dark": "#8AB4F8" },
    "secondary": { "light": "#5F6368", "dark": "#9AA0A6" },
    "background": { "light": "#FFFFFF", "dark": "#131314" },
    "surface": { "light": "#F1F3F4", "dark": "#1E1F20" },
    "textPrimary": { "light": "#202124", "dark": "#E3E3E3" },
    "textSecondary": { "light": "#5F6368", "dark": "#9AA0A6" },
    "error": { "light": "#D93025", "dark": "#F2B8B5" },
    "warning": { "light": "#F9AB00", "dark": "#FDD663" },
    "success": { "light": "#188038", "dark": "#81C995" },
    "recordingAlert": { "light": "#D93025", "dark": "#FF8A80" }
  },
  "typography": {
    "fontFamily": "Inter",
    "fallback": "Roboto, San Francisco",
    "h1": { "size": 24, "weight": 700, "lineHeight": 32 },
    "h2": { "size": 20, "weight": 700, "lineHeight": 28 },
    "h3": { "size": 16, "weight": 600, "lineHeight": 24 },
    "body": { "size": 14, "weight": 400, "lineHeight": 20 },
    "button": { "size": 14, "weight": 600, "lineHeight": 20 },
    "caption": { "size": 12, "weight": 400, "lineHeight": 16 }
  },
  "spacing": { "base": 4, "scale": [4, 8, 12, 16, 24, 32] },
  "radius": { "sm": 8, "md": 12, "lg": 16 },
  "motion": { "fastMs": 150, "standardMs": 250 },
  "a11y": { "minTouchDp": 48, "minBodySp": 14, "recordingLabel": "RECORDING" }
